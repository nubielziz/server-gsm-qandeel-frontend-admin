# Base URL of the GSM API (the map's https://api.<domain>). Leave empty to call the same origin (dev proxy or mocks).
VITE_API_BASE_URL=https://api.example.com
# Name of the readable cookie that carries the CSRF token (decision 006). The X-CSRF-Token response header is the fallback.
VITE_CSRF_COOKIE=csrf_token
# Public storefront URL, used for "open storefront" links.
VITE_STOREFRONT_URL=https://www.example.com
# Dev only: proxy /admin and /health to this server so the browser sees one origin (then leave VITE_API_BASE_URL empty).
VITE_DEV_PROXY_TARGET=
# Dev only: true starts the MSW mock layer seeded from the demo data (never allowed in production builds).
VITE_API_MOCKS=false
