# Base URL of the GSM API (the map's https://api.<domain>). Leave empty to call the same origin (dev proxy or mocks).
VITE_API_BASE_URL=https://api.example.com
# Name of the readable cookie that carries the CSRF token (decision 006). The X-CSRF-Token response header is the fallback.
VITE_CSRF_COOKIE=csrf_token
# Public storefront URL, used for "open storefront" links.
VITE_STOREFRONT_URL=https://www.example.com
# Dev only: proxy /admin and /health to this server so the browser sees one origin (then leave VITE_API_BASE_URL empty).
VITE_DEV_PROXY_TARGET=
# Dev only: how the MSW mock layer runs (never allowed in production builds; `true` and `unbuilt` are refused).
#   false    no mocks: every call goes to the real API.
#   true     every route is answered by the mocks, seeded from the demo data (no backend needed).
#   unbuilt  routes the real backend has built go to the real API through the dev proxy, the rest stay mocked.
#            Needs VITE_DEV_PROXY_TARGET set and VITE_API_BASE_URL empty. Run `npm run mocks:live` after the backend changes.
VITE_API_MOCKS=false
# System health deep links. Each "Open in …" link shows only when its URL is set; leave empty to hide it.
# Grafana dashboard of the API (header and API tab).
VITE_GRAFANA_URL=
# Sentry project (top errors; each error's own Sentry link also needs this set).
VITE_SENTRY_URL=
# Bull Board (queues tab; a queue opens at <url>/queue/<name>). The API serves it at <api>/admin/queues.
VITE_BULL_BOARD_URL=
