{
  "name": "gsm-admin-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GSM Supply admin console: a Refine port of the gsm-admin demo against the /admin API map.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "routes:manifest": "node scripts/build-route-manifest.mjs",
    "gen:types": "node scripts/gen-entity-types.mjs",
    "seed:extract": "node scripts/extract-demo-seed.mjs",
    "routes:coverage": "node scripts/check-route-coverage.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-hook-form": "^5.0.4",
    "@refinedev/react-router": "^2.0.4",
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "src/mocks/worker"
    ]
  }
}
