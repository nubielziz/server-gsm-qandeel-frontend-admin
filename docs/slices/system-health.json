{
  "feature": "system-health",
  "page": "/system-health",
  "demo": [],
  "folders": [
    "src/features/system-health"
  ],
  "notes": "No demo page: designed in docs/system-health-design.md. Overview, API, orders and suppliers, queues and jobs, alerts and incidents, data stores, integrity, maintenance. Pausing a supplier reuses updateSupplier from features/suppliers (PATCH /admin/suppliers/:id, status = paused).",
  "rules": {
    "pagination": "Refine simple-rest: _start, _end, _sort, _order, field filters; total count in the x-total-count header",
    "errors": "application/problem+json {type,title,status,code,detail,errors[]}",
    "crud": "L=GET /resource (list), S=GET /resource/:id (show), C=POST /resource (create), U=PATCH /resource/:id (update), D=DELETE /resource/:id (delete); every other row is one endpoint with op \"action\""
  },
  "endpoints": [
    {
      "key": "GET /admin/system/health",
      "method": "GET",
      "path": "/admin/system/health",
      "group": "health",
      "op": "action",
      "description": "Overall status (Operational, Degraded or Outage), the running build (version, commit, environment), the status of each component, uptime over 24 hours, 7 and 30 days, open alerts, ongoing incidents and the maintenance state.",
      "access": "permission",
      "permission": "system:read",
      "stage": 9,
      "tables": [
        "service_checks",
        "alert_events",
        "incidents",
        "settings"
      ],
      "origin": {
        "method": "GET",
        "ops": null,
        "path": "/admin/system/health"
      }
    },
