      "key": "GET /admin/orders",
      "method": "GET",
      "path": "/admin/orders",
      "group": "orders",
      "op": "list",
      "description": "Orders and their queues (pending, manual, needs_attention, verification, review); filter by channel=b2b|b2c.",
      "access": "permission",
      "permission": "orders:read",
      "stage": 5,
      "tables": [
        "orders"
      ],
      "origin": {
        "method": "CRUD",
        "ops": "LS",
        "path": "/admin/orders"
      }
    },
    {
      "key": "GET /admin/orders/:id",
      "method": "GET",
